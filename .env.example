# ==============================================================================
# JobTrail - Environment Configuration Template (.env.example)
# ==============================================================================
# Kopieren Sie diese Datei zu '.env' und passen Sie die Werte an:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Linux / macOS:        cp .env.example .env
#
# HINWEIS: Echte Passwörter und Secrets dürfen NIEMALS in die Versionsverwaltung!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. PostgreSQL Datenbankkonfiguration
# ------------------------------------------------------------------------------
# Name der Datenbank
POSTGRES_DB=jobtrail

# Benutzername für PostgreSQL (lokale Entwicklung: postgres)
DB_USERNAME=postgres

# Datenbankpasswort (in Produktion durch ein starkes Passwort ersetzen)
DB_PASSWORD=postgres_dev_password_change_in_prod

# Host-Port für PostgreSQL (5433 verhindert Konflikte mit lokalem Standard-PostgreSQL auf 5432)
DB_PORT=5433

# ------------------------------------------------------------------------------
# 2. Spring Boot Anwendungs- und Serverkonfiguration
# ------------------------------------------------------------------------------
# HTTP-Port der API
SERVER_PORT=8080

# Aktives Spring-Profil: 'dev' für lokale Maven-Entwicklung, 'prod' für Docker Compose
SPRING_PROFILES_ACTIVE=prod

# Automatische Demo-Daten beim Start laden (true/false)
JOBTRAIL_DEMO_DATA_ENABLED=true

# ------------------------------------------------------------------------------
# 3. Authentifizierung & JWT (JSON Web Token)
# ------------------------------------------------------------------------------
# HMAC-SHA256 Secret (mindestens 32 Zeichen / 256 Bit erforderlich).
# Generierung eines sicheren Schlüssels via Terminal:
#   PowerShell:   [Convert]::ToBase64String((1..48 | ForEach-Object { Get-Random -Maximum 256 }))
#   Bash/OpenSSL: openssl rand -base64 48
JWT_SECRET=replace-with-a-secure-random-secret-key-min-32-bytes-long!

# Token-Gültigkeitsdauer im ISO-8601-Dauerformat (Standard: PT1H = 1 Stunde)
JWT_EXPIRATION=PT1H

# Token-Aussteller (Issuer-Claim)
JWT_ISSUER=jobtrail

# ------------------------------------------------------------------------------
# 4. KI-Job-Matching (Optional - OpenAI API)
# ------------------------------------------------------------------------------
# API-Key von OpenAI (z. B. sk-proj-...). Wenn leer gelassen, startet das Backend
# normal und gibt beim Aufruf von /api/job-match/analyze HTTP 503 (Disabled) zurück.
OPENAI_API_KEY=

# Rate-Limiting für KI-Matching-Anfragen pro Benutzer und Minute (Standard: 5)
JOB_MATCH_REQUESTS_PER_MINUTE=5

# ------------------------------------------------------------------------------
# 5. OpenAPI & Swagger UI Dokumentation
# ------------------------------------------------------------------------------
# Swagger UI unter http://localhost:8080/swagger-ui/index.html aktivieren
SPRINGDOC_SWAGGER_UI_ENABLED=true

# OpenAPI v3 JSON-Spezifikation unter http://localhost:8080/v3/api-docs aktivieren
SPRINGDOC_API_DOCS_ENABLED=true
