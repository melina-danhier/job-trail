# ==========================================
# JobTrail Environment Configuration
# ==========================================

# Database
POSTGRES_DB=jobtrail
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_PORT=5433

# Spring Boot Application
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=prod

# JWT Secret (mindestens 32 Zeichen / 256 Bit)
JWT_SECRET=mein-super-langes-geheimes-passwort-mit-mindestens-32-zeichen

# OpenAI API Key (optional fuer KI-Job-Matching)
OPENAI_API_KEY=

# Swagger UI / OpenAPI Dokumentation
SPRINGDOC_SWAGGER_UI_ENABLED=true
SPRINGDOC_API_DOCS_ENABLED=true
